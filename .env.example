# Скопируйте в .env
MISTERIO_LLM_BASE_URL=http://127.0.0.1:11434/v1
MISTERIO_LLM_API_KEY=local
MISTERIO_LLM_MODEL=qwen3:8b
MISTERIO_OLLAMA_MODEL=qwen3:8b
MISTERIO_LLM_TIMEOUT_S=300
MISTERIO_LLM_CONNECT_TIMEOUT_S=5

# Если агент сам запущен в контейнере в той же compose-сети:
# MISTERIO_LLM_BASE_URL=http://ollama:11434/v1

# Локальный GigaChat 3.1 через профиль llama.cpp из docker-compose.yml:
# MISTERIO_LLM_BASE_URL=http://127.0.0.1:8080/v1
# MISTERIO_LLM_API_KEY=local
# MISTERIO_LLM_MODEL=ai-sage/GigaChat3.1-10B-A1.8B-GGUF:Q4_K_M
